library(readxl)
library(car)
library(tseries)
data <- read_excel("~/Downloads/Data_examples.xlsx",
sheet = "VHLSS.2018.HN")
mean_size <- mean(data$SIZE, na.rm = TRUE)
cat("Sample mean of SIZE =", mean_size, "\n")
# Sample variance of FOOD
var_food <- var(data$FOOD, na.rm = TRUE)
cat("Sample variance of FOOD =", var_food, "\n")
# Standard deviation of CONSUM
sd_consum <- sd(data$CONSUM, na.rm = TRUE)
cat("Standard deviation of CONSUM =", sd_consum, "\n")
# Median of CONSUM
median_consum <- median(data$CONSUM, na.rm = TRUE)
cat("Median of CONSUM =", median_consum, "\n")
# Covariance of CONSUM and INCOME
cov_cons_inc <- cov(data$CONSUM, data$INCOME, use = "complete.obs")
cat("Covariance of CONSUM and INCOME =", cov_cons_inc, "\n")
# Correlation of CONSUM and INCOME
cor_cons_inc <- cor(data$CONSUM, data$INCOME, use = "complete.obs")
cat("Correlation of CONSUM and INCOME =", cor_cons_inc, "\n")
sd_consum <- sd(CONSUM, na.rm = TRUE)
attach(data)
mean_size <- mean(SIZE, na.rm = TRUE)
cat("Sample mean of SIZE =", mean_size, "\n")
sd_consum <- sd(CONSUM, na.rm = TRUE)
cat("Standard deviation of CONSUM =", sd_consum, "\n")
var_food <- var(FOOD, na.rm = TRUE)
cat("Sample variance of FOOD =", var_food, "\n")
sd_consum <- sd(CONSUM, na.rm = TRUE)
cat("Standard deviation of CONSUM =", sd_consum, "\n")
median_consum <- median(CONSUM, na.rm = TRUE)
cat("Median of CONSUM =", median_consum, "\n")
cov_cons_inc <- cov(CONSUM, INCOME, use = "complete.obs")
cat("Covariance of CONSUM and INCOME =", cov_cons_inc, "\n")
cor_cons_inc <- cor(CONSUM, INCOME, use = "complete.obs")
cat("Correlation of CONSUM and INCOME =", cor_cons_inc, "\n")
model1 <- lm(FOOD ~ INCOME + SIZE)
summary(model1)
# Các hệ số
beta2 <- coef(model1)["INCOME"]
cat("\nEstimated β₂ =", beta2, "\n")
# R-squared
r2 <- summary(model1)$r.squared
cat("R-squared =", r2, "\n")
# F-statistic
f_stat <- summary(model1)$fstatistic[1]
cat("F-statistic =", f_stat, "\n")
# Covariance between β₂ and β₃
cov_b2_b3 <- vcov(model1)["INCOME", "SIZE"]
cat("Covariance β₂ and β₃ =", cov_b2_b3, "\n")
conf_int_b3 <- confint(model1, "SIZE", level = 0.90)
cat("\n90% CI for β₃ (SIZE):")
cat("\nLower bound =", conf_int_b3[1], "\n")
cat("Upper bound =", conf_int_b3[2], "\n")
test_b2 <- linearHypothesis(model1, "INCOME = 0.2")
cat("\nF-statistic for H0: β₂ = 0.2 =", test_b2$F[2], "\n")
resid_20 <- residuals(model1)[20]
cat("\nResidual at 20th observation =", resid_20, "\n")
fitted_50 <- fitted(model1)[50]
cat("Fitted value at 50th observation =", fitted_50, "\n")
rmse <- sqrt(mean(residuals(model1)^2, na.rm = TRUE))
cat("\nRMSE =", rmse, "\n")
mae <- mean(abs(residuals(model1)), na.rm = TRUE)
cat("MAE =", mae, "\n")
model1_no_size <- lm(FOOD ~ INCOME)
anova_test <- anova(model1_no_size, model1)
cat("\nF-statistic for removing SIZE =", anova_test$F[2], "\n")
cat("P-value =", anova_test$`Pr(>F)`[2], "\n")
model1_with_urban <- lm(FOOD ~ INCOME + SIZE + URBAN)
p_value_urban <- summary(model1_with_urban)$coefficients["URBAN", 4]
cat("\nP-value for adding URBAN =", p_value_urban, "\n")
new_data <- data.frame(INCOME = 1000, SIZE = 5)
# Dự báo điểm
pred_point <- predict(model1, newdata = new_data)
cat("\nPredicted FOOD (INCOME=1000, SIZE=5) =", pred_point, "\n")
# Khoảng tin cậy 95% cho E(FOOD)
pred_mean_95 <- predict(model1, newdata = new_data,
interval = "confidence", level = 0.95)
cat("95% CI for E(FOOD): lower bound =", pred_mean_95[,"lwr"], "\n")
# Khoảng dự báo 90% cho cá biệt
pred_individual_90 <- predict(model1, newdata = new_data,
interval = "prediction", level = 0.90)
cat("90% PI for individual FOOD: upper bound =", pred_individual_90[,"upr"], "\n")
